---
import type { Lang } from "../lib";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === "zh";
const shape = [
  "00000000",
  "01100110",
  "11111111",
  "11111111",
  "01111110",
  "00111100",
  "00011000",
  "00000000",
].join("");
---

<div class="pixel-toy" data-pixel-toy>
  <div class="pixel-top">
    <span>PIXEL STUDY / 8 × 8</span>
    <span class="pixel-led" aria-hidden="true"></span>
  </div>
  <div
    class="pixel-grid"
    role="group"
    aria-label={
      zh
        ? "像素画板，点击像素切换颜色"
        : "Pixel board. Click a pixel to change its color."
    }
  >
    {Array.from(shape).map((value, i) => (
      <button
        disabled
        type="button"
        class:list={["pixel", { lit: value === "1" }]}
        aria-label={
          zh
            ? `第 ${Math.floor(i / 8) + 1} 行，第 ${(i % 8) + 1} 列`
            : `Row ${Math.floor(i / 8) + 1}, column ${(i % 8) + 1}`
        }
        aria-pressed={value === "1" ? "true" : "false"}
        data-initial={value}
        tabindex={i === 0 ? 0 : -1}
      ></button>
    ))}
  </div>
  <div class="pixel-controls" hidden>
    <div
      class="swatches"
      role="group"
      aria-label={zh ? "画笔颜色" : "Brush color"}
    >
      {[
        ["#b54522", zh ? "橙红" : "Orange"],
        ["#3b684b", zh ? "绿色" : "Green"],
        ["#5254a3", zh ? "紫色" : "Purple"],
      ].map(([color, label], i) => (
        <button
          type="button"
          class="swatch"
          style={`--swatch:${color}`}
          data-color={color}
          aria-label={label}
          aria-pressed={i === 0 ? "true" : "false"}
        ></button>
      ))}
    </div>
    <button type="button" class="pixel-reset">
      {zh ? "重置" : "Reset"} ↺
    </button>
  </div>
  <p class="pixel-hint">
    {zh
      ? "点击像素作画 · 也可以用方向键移动"
      : "Click to paint · Arrow keys to move"}
  </p>
  <noscript>
    <p class="pixel-hint">
      {zh
        ? "启用 JavaScript 后可以点亮像素。"
        : "Enable JavaScript to paint the pixels."}
    </p>
  </noscript>
</div>
<script>
  const toy = document.querySelector<HTMLElement>("[data-pixel-toy]");
  if (toy) {
    let color = "#b54522";
    const pixels = Array.from(
      toy.querySelectorAll<HTMLButtonElement>(".pixel"),
    );
    toy.querySelector<HTMLElement>(".pixel-controls")!.hidden = false;
    pixels.forEach((pixel, index) => {
      pixel.disabled = false;
      pixel.addEventListener("click", () => {
        const on = pixel.getAttribute("aria-pressed") === "true";
        const sameColor = (pixel.dataset.color || "#b54522") === color;
        const next = !(on && sameColor);
        pixel.setAttribute("aria-pressed", String(next));
        pixel.classList.toggle("lit", next);
        pixel.style.setProperty("--pixel-color", color);
        pixel.dataset.color = color;
      });
      pixel.addEventListener("keydown", (event) => {
        const moves: Record<string, number> = {
          ArrowRight: 1,
          ArrowLeft: -1,
          ArrowDown: 8,
          ArrowUp: -8,
        };
        if (!(event.key in moves)) return;
        event.preventDefault();
        const target = (index + moves[event.key] + 64) % 64;
        pixels.forEach((p, i) => (p.tabIndex = i === target ? 0 : -1));
        pixels[target].focus();
      });
      pixel.addEventListener("focus", () =>
        pixels.forEach((p) => (p.tabIndex = p === pixel ? 0 : -1)),
      );
    });
    toy.querySelectorAll<HTMLButtonElement>(".swatch").forEach((button) =>
      button.addEventListener("click", () => {
        color = button.dataset.color!;
        toy
          .querySelectorAll(".swatch")
          .forEach((p) => p.setAttribute("aria-pressed", String(p === button)));
      }),
    );
    toy.querySelector(".pixel-reset")?.addEventListener("click", () =>
      pixels.forEach((pixel) => {
        const on = pixel.dataset.initial === "1";
        pixel.classList.toggle("lit", on);
        pixel.setAttribute("aria-pressed", String(on));
        pixel.style.removeProperty("--pixel-color");
        delete pixel.dataset.color;
      }),
    );
  }
</script>
