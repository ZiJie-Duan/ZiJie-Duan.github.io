---
import Base from "../layouts/Base.astro";
import PixelBoard from "./PixelBoard.astro";
import { site } from "../../site.config.mjs";
import { href, type Lang } from "../lib";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === "zh";
const say = (cn: string, en: string) => (zh ? cn : en);
const archive = [
  {
    name: "Shirai-Kuroko",
    repo: "Shirai-Kuroko",
    type: "tools",
    desc: say(
      "让文件轻松抵达另一端。",
      "A small CLI to send files on their way.",
    ),
    tech: "Python · CLI",
  },
  {
    name: "WireGuard Config Wizard",
    repo: "wg-config-wizard",
    type: "systems",
    desc: say(
      "把复杂的隧道配置变简单。",
      "Making complex tunnel configurations simpler.",
    ),
    tech: "Python · Networking",
  },
  {
    name: "Ayanami-Rei",
    repo: "Ayanami-Rei-rs",
    type: "systems",
    desc: say(
      "用 Rust 控制作为 HID 设备的树莓派。",
      "A Rust client for a Raspberry Pi HID device.",
    ),
    tech: "Rust · Raspberry Pi",
  },
  {
    name: "Auto Film Developer",
    repo: "Auto_Film_Developer",
    type: "hardware",
    desc: say(
      "一个基于 ESP32 的小型胶片冲洗机项目。",
      "A small ESP32-based film development project.",
    ),
    tech: "C++ · ESP32",
  },
  {
    name: "WWB Timer",
    repo: "wwb_timer",
    type: "hardware",
    desc: say(
      "屏幕、开关与串口，组成一件交互小设备。",
      "Displays, a switch, and a serial API in a little device.",
    ),
    tech: "Python · ESP32-C3",
  },
  {
    name: say("晶子の光", "Akiko-no-Hikari"),
    repo: "akiko-no-hikari",
    type: "hardware",
    desc: say("微缩城市灯光实验。", "A miniature city lighting experiment."),
    tech: "MicroPython · RP2040",
  },
];
---

<Base
  lang={lang}
  home
  title={site.name[lang]}
  description={site.intro[lang]}
  alternate={href(zh ? "en" : "zh")}
>
  <section class="intro" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="eyebrow">
        <span class="tiny-star" aria-hidden="true">
          ✳
        </span>{" "}
        A PERSONAL SPACE FOR MAKING THINGS
      </p>
      <p class="hello">{say("你好，我是段子杰。", "Hello, I’m ZiJie Duan.")}</p>
      <h1 id="intro-title">
        {say("让想法，", "Ideas into")}
        <br />
        <em>{say("成为现实。", "real things.")}</em>
      </h1>
      <p class="intro-description">
        {say(
          "探索 AI、软件系统与交互硬件。",
          "Exploring AI, software systems, and interactive hardware.",
        )}
        <br />
        {say(
          "把好奇心写进代码，把工具带进生活。",
          "Following curiosity. Building things for everyday life.",
        )}
      </p>
      <div class="intro-actions">
        <a class="solid-link" href="#work">
          {say("看看我的作品", "Explore my work")}
          <span aria-hidden="true">↘</span>
        </a>
        <a class="text-link" href="https://github.com/ZiJie-Duan">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="instrument" aria-hidden="true">
      <div class="instrument-top">
        <span>THE CURIOSITY ENGINE</span>
        <span>FIG. 01</span>
      </div>
      <div class="instrument-field">
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <div class="orbit orbit-three"></div>
        <div class="core">
          <span>
            z<span class="core-dot">.</span>
          </span>
        </div>
        <span class="node node-ai">
          <i></i> AI
        </span>
        <span class="node node-code">
          <i></i> CODE
        </span>
        <span class="node node-make">
          <i></i> HARDWARE
        </span>
        <span class="cross cross-a">+</span>
        <span class="cross cross-b">+</span>
      </div>
      <div class="instrument-bottom">
        <span>IDEA → EXPERIMENT → REALITY</span>
        <span class="signal">
          <i></i>
          <i></i>
          <i></i>
          <i></i>
          <i></i>
        </span>
      </div>
    </div>
    <div class="intro-foot">
      <span>SOFTWARE / SYSTEMS / SMALL EXPERIMENTS</span>
      <a href="#work">{say("向下探索", "SCROLL TO EXPLORE")} ↓</a>
    </div>
  </section>
  <section id="work" class="work-section" aria-labelledby="work-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / SELECTED WORK</p>
        <h2 id="work-title">
          {say("从想法，到日常。", "From ideas to everyday.")}
        </h2>
      </div>
      <p>
        {say("一些正在打磨的工具，", "Tools I’m working on,")}
        <br />
        {say(
          "一些由好奇心开始的实验。",
          "and experiments sparked by curiosity.",
        )}
      </p>
    </div>
    <div class="project-grid">
      <article class="project">
        <a
          class="project-art utter-art"
          href={href(lang, "utter")}
          aria-label={say("了解 Utter", "Explore Utter")}
        >
          <span class="art-corner">UTTER / VOICE-FIRST INPUT</span>
          <div class="utter-visual">
            <span class="utter-symbol" aria-hidden="true">
              u<span>•</span>
            </span>
            <div class="wave" aria-hidden="true">
              {[
                12, 21, 34, 18, 40, 58, 31, 46, 65, 41, 23, 50, 34, 18, 29, 12,
                20,
              ].map((n, i) => (
                <i style={`--bar:${n}px;--delay:${i * 45}ms`}></i>
              ))}
            </div>
            <p>{say("说出来，就好了。", "Just say it.")}</p>
            <span class="utter-caption">
              {say(
                "语音 → 整理 → 输入 · 流程示意",
                "VOICE → REFINE → TYPE · WORKFLOW CONCEPT",
              )}
            </span>
          </div>
          <span class="art-bottom">
            iOS KEYBOARD <span aria-hidden="true">↗</span>
          </span>
        </a>
        <div class="project-meta">
          <span class="eyebrow">01 / AI & PRODUCTIVITY</span>
          <span class="status">{say("开发中", "IN DEVELOPMENT")}</span>
        </div>
        <h3>
          <a href={href(lang, "utter")}>
            Utter <span aria-hidden="true">↗</span>
          </a>
        </h3>
        <p>
          {say(
            "语音优先的中文输入法。把说出的话整理成文字，让表达更自然地进入日常。",
            "A voice-first Chinese keyboard. Turning spoken thoughts into text, for a more natural way to write.",
          )}
        </p>
        <a class="project-link" href={href(lang, "utter")}>
          {say("应用介绍与测试说明", "App details & beta information")}{" "}
          <span aria-hidden="true">↗</span>
        </a>
      </article>
      <article class="project">
        <a
          class="project-art sync-art"
          href="https://github.com/ZiJie-Duan/SyncListen"
          aria-label={say("查看 SyncListen 源码", "View SyncListen source")}
        >
          <span class="art-corner">SYNCLISTEN / A QUIETER WORKFLOW</span>
          <div class="terminal" aria-hidden="true">
            <div class="terminal-head">
              <span>● ● ●</span>
              <span>synclisten</span>
              <span>↗</span>
            </div>
            <div class="terminal-body">
              <p>
                <span class="terminal-prompt">~</span> ./run.sh
              </p>
              <p class="terminal-muted">
                {say("想法从一句话开始。", "An idea starts with a sentence.")}
              </p>
              <p class="terminal-line">
                <span>›</span>{" "}
                {say("说话。整理。继续创造。", "Speak. Refine. Keep creating.")}
                <i></i>
              </p>
              <div class="terminal-rule"></div>
              <p class="terminal-options">
                [enter] write <span>[c] copy</span>
              </p>
              <p class="terminal-note">
                {say("交互流程示意", "ILLUSTRATIVE WORKFLOW")}
              </p>
            </div>
          </div>
          <span class="art-bottom">
            PYTHON / OPEN SOURCE <span aria-hidden="true">↗</span>
          </span>
        </a>
        <div class="project-meta">
          <span class="eyebrow">02 / VOICE & WORKFLOW</span>
          <span class="status">{say("开源项目", "OPEN SOURCE")}</span>
        </div>
        <h3>
          <a href="https://github.com/ZiJie-Duan/SyncListen">
            SyncListen <span aria-hidden="true">↗</span>
          </a>
        </h3>
        <p>
          {say(
            "一个轻量的语音写作工作流。录音、转写、AI 整理，把精力留给真正想说的内容。",
            "A minimal voice-to-text workflow. Record, transcribe, and refine with AI, leaving more room for what you want to say.",
          )}
        </p>
        <a class="project-link" href="https://github.com/ZiJie-Duan/SyncListen">
          {say("在 GitHub 查看项目", "Explore on GitHub")}{" "}
          <span aria-hidden="true">↗</span>
        </a>
      </article>
    </div>
  </section>
  <section class="play-section" aria-labelledby="play-title">
    <div class="play-copy">
      <p class="eyebrow">02 / A LITTLE ROOM TO PLAY</p>
      <h2 id="play-title">
        {say("也做一点，", "A little room")}
        <br />
        <em>{say("有趣的事。", "for play.")}</em>
      </h2>
      <p>
        {say(
          "从屏幕上的一个像素，到桌面上的一束光。软件之外，我也喜欢动手做一些小东西。",
          "From a pixel on a screen to a light on a desk. Beyond software, I like making little things you can reach out and touch.",
        )}
      </p>
      <a
        class="project-link"
        href="https://github.com/ZiJie-Duan/ag-drawing-board"
      >
        {say("探索像素画板项目", "Explore the pixel board project")} ↗
      </a>
    </div>
    <PixelBoard lang={lang} />
  </section>
  <section class="archive-section" aria-labelledby="archive-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / THE WORKBENCH</p>
        <h2 id="archive-title">{say("更多探索", "More explorations")}</h2>
      </div>
      <div
        class="filters"
        role="group"
        aria-label={say("筛选项目", "Filter projects")}
        hidden
      >
        {[
          ["all", say("全部", "All")],
          ["tools", say("工具", "Tools")],
          ["systems", say("系统", "Systems")],
          ["hardware", say("硬件", "Hardware")],
        ].map(([key, label]) => (
          <button
            type="button"
            data-filter={key}
            aria-pressed={key === "all" ? "true" : "false"}
          >
            {label}
          </button>
        ))}
      </div>
    </div>
    <div class="archive-list">
      {archive.map((p, i) => (
        <a
          class="archive-row"
          data-category={p.type}
          href={`https://github.com/ZiJie-Duan/${p.repo}`}
        >
          <span class="archive-number">0{i + 1}</span>
          <span class="archive-name">
            {p.name}
            <span>{p.desc}</span>
          </span>
          <span class="archive-tech">{p.tech}</span>
          <span class="archive-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
    <p
      class="archive-note"
      aria-live="polite"
      data-count
      data-zh={zh ? "true" : "false"}
    >
      {say(
        "6 个项目 · 更多代码与实验，在 GitHub。",
        "6 projects · More code and experiments on GitHub.",
      )}
    </p>
  </section>
  <section id="about" class="about-section" aria-labelledby="about-title">
    <div>
      <p class="eyebrow">04 / THE PERSON BEHIND THE CODE</p>
      <h2 id="about-title">
        {say("保持好奇。", "Stay curious.")}
        <br />
        <em>{say("继续动手。", "Keep building.")}</em>
      </h2>
    </div>
    <div class="about-copy">
      <p class="about-lead">
        {say(
          "我是段子杰，也叫 Peter。",
          "I’m ZiJie. You can also call me Peter.",
        )}
      </p>
      <p>
        {say(
          "我对工具如何改变日常工作很感兴趣：更自然的输入方式、更顺手的软件，以及连接数字与现实的小设备。",
          "I’m interested in how tools can change everyday work: more natural ways to write, software that feels useful, and small devices that connect the digital and physical worlds.",
        )}
      </p>
      <p>
        {say(
          "这里收集我写的代码、正在打磨的应用，以及一些没有标准答案的小实验。",
          "This is a home for my code, apps in progress, and little experiments without a predetermined answer.",
        )}
      </p>
      <div class="about-topics">
        <span>AI & SOFTWARE</span>
        <span>CONNECTED SYSTEMS</span>
        <span>CREATIVE HARDWARE</span>
      </div>
    </div>
  </section>
  <section class="contact-section" aria-labelledby="contact-title">
    <div>
      <p class="eyebrow">HAVE SOMETHING IN MIND?</p>
      <h2 id="contact-title">
        {say("有意思的想法，欢迎来聊。", "Good ideas start with a hello.")}
      </h2>
    </div>
    <a class="contact-button" href={`mailto:${site.email}`}>
      {say("打个招呼", "Say hello")} <span aria-hidden="true">↗</span>
    </a>
  </section>
</Base>
<script>
  const filters = document.querySelector<HTMLElement>(".filters");
  if (filters) {
    filters.hidden = false;
    filters.querySelectorAll<HTMLButtonElement>("button").forEach((button) =>
      button.addEventListener("click", () => {
        const selected = button.dataset.filter;
        filters
          .querySelectorAll("button")
          .forEach((item) =>
            item.setAttribute("aria-pressed", String(item === button)),
          );
        let count = 0;
        document
          .querySelectorAll<HTMLElement>(".archive-row")
          .forEach((row) => {
            row.hidden =
              selected !== "all" && row.dataset.category !== selected;
            if (!row.hidden) count++;
          });
        const note = document.querySelector<HTMLElement>("[data-count]");
        if (note)
          note.textContent =
            note.dataset.zh === "true"
              ? `${count} 个项目 · 更多代码与实验，在 GitHub。`
              : `${count} ${count === 1 ? "project" : "projects"} · More code and experiments on GitHub.`;
      }),
    );
  }
</script>
