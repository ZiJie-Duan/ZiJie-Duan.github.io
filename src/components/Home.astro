---
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import { site } from "../../site.config.mjs";
import { href, type Lang } from "../lib";
import {
  projects,
  categories,
  languageCounts,
  type Category,
} from "../data/projects";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === "zh";
const t = (cn: string, en: string) => (zh ? cn : en);
const projectUrl = href(lang, "projects");
const directions = [
  {
    id: "ai",
    title: t("AI 与交互", "AI & interaction"),
    icon: "spark",
    text: t(
      "让机器更好地理解人的表达。探索语音输入、字幕、语言模型工具，以及强化学习。",
      "Helping computers understand human expression, through voice input, subtitles, language-model tools, and reinforcement learning.",
    ),
    tags: ["Python", "TypeScript", "Speech", "LLM"],
  },
  {
    id: "systems",
    title: t("系统与网络", "Systems & networks"),
    icon: "network",
    text: t(
      "关注工具之间如何连接。把网络配置、终端控制和跨平台集成，拆成可理解、可使用的模块。",
      "Exploring how tools connect. Turning network configuration, terminal control, and cross-platform integration into understandable, useful components.",
    ),
    tags: ["Rust", "Swift", "Networking", "CLI"],
  },
  {
    id: "hardware",
    title: t("硬件与制造", "Hardware & making"),
    icon: "chip",
    text: t(
      "把代码带到屏幕之外。从微控制器、传感器和显示屏出发，尝试一些可以拿在手里的交互。",
      "Taking code beyond the screen. Starting with microcontrollers, sensors, and displays to build interactions you can hold in your hands.",
    ),
    tags: ["ESP32", "RP2040", "STM32", "MicroPython"],
  },
];
const original = projects.filter((p) => !p.fork).length;
---

<Base
  lang={lang}
  home
  title={site.name[lang]}
  description={site.intro[lang]}
  alternate={href(zh ? "en" : "zh")}
>
  <section class="home-intro">
    <div class="intro-copy">
      <span class="intro-label">
        <i aria-hidden="true"></i>
        {t("开发者 · 探索者", "Developer · Explorer")}
      </span>
      <h1>
        {t("段子杰", "ZiJie Duan")}
        <span>{t("ZiJie Duan / Peter", "段子杰 / Peter")}</span>
      </h1>
      <p class="intro-lead">
        {t("写代码，也动手创造。", "Building with code. And beyond it.")}
      </p>
      <p class="intro-description">
        {t(
          "我关注 AI 工具、软件系统与交互硬件，喜欢把想法做成能用的东西，也把一路上的学习和实验留在这里。",
          "I explore AI tools, software systems, and interactive hardware. I like turning ideas into useful things, and keeping a record of what I learn along the way.",
        )}
      </p>
      <div class="intro-actions">
        <a class="primary-button" href={projectUrl}>
          {t("浏览项目", "Explore projects")}
          <Icon name="arrow" size={17} />
        </a>
        <a class="quiet-link" href="https://github.com/ZiJie-Duan">
          <Icon name="github" size={18} />
          GitHub
          <Icon name="external" size={14} />
        </a>
      </div>
      <div class="intro-footnote">
        <span>2018 — {new Date().getFullYear()}</span>
        <span>
          {t("公开代码与学习记录。", "A record of public code and learning.")}
        </span>
      </div>
    </div>
    <div class="direction-card panel">
      <div class="panel-heading">
        <span>{t("探索方向", "Areas of exploration")}</span>
        <span class="small-label">01 — 03</span>
      </div>
      <div
        class="direction-tabs"
        role="tablist"
        aria-label={t("探索方向", "Areas of exploration")}
        hidden
      >
        {directions.map((d, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${d.id}`}
            aria-controls={`direction-${d.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-direction={d.id}
          >
            <Icon name={d.icon} size={17} />
            <span>
              {t(
                d.id === "ai" ? "AI" : d.id === "systems" ? "系统" : "硬件",
                d.id === "ai"
                  ? "AI"
                  : d.id === "systems"
                    ? "Systems"
                    : "Hardware",
              )}
            </span>
          </button>
        ))}
      </div>
      {directions.map((d, i) => (
        <section
          id={`direction-${d.id}`}
          class="direction-panel"
          role="tabpanel"
          aria-labelledby={`tab-${d.id}`}
          tabindex="0"
          data-panel={d.id}
        >
          <div class={`direction-graphic graphic-${d.id}`} aria-hidden="true">
            <div class="graphic-grid"></div>
            {d.id === "ai" ? (
              <div class="signal-bars">
                {[
                  14, 28, 19, 46, 34, 64, 44, 80, 54, 38, 70, 46, 28, 54, 22,
                  36, 16,
                ].map((h, j) => (
                  <i style={`--height:${h}px;--i:${j}`}></i>
                ))}
              </div>
            ) : d.id === "systems" ? (
              <div class="system-blocks">
                <span>
                  <Icon name="code" size={26} />
                </span>
                <i></i>
                <span>
                  <Icon name="network" size={26} />
                </span>
                <i></i>
                <span>
                  <Icon name="globe" size={26} />
                </span>
              </div>
            ) : (
              <div class="hardware-blocks">
                {Array.from({ length: 32 }, (_, j) => (
                  <i
                    class:list={[
                      {
                        on: [
                          3, 6, 10, 11, 12, 13, 17, 18, 19, 20, 21, 26, 27,
                        ].includes(j),
                      },
                    ]}
                  ></i>
                ))}
              </div>
            )}
          </div>
          <div class="direction-copy">
            <div class="direction-title">
              <h2>{d.title}</h2>
              <span>
                {String(
                  projects.filter((p) => p.category === d.id).length,
                ).padStart(2, "0")}{" "}
                <small>{t("个仓库", "repos")}</small>
              </span>
            </div>
            <p>{d.text}</p>
            <div class="tech-tags">
              {d.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
            <a class="panel-link" href={`${projectUrl}?category=${d.id}`}>
              {t("探索这个方向", "Explore this area")}
              <Icon name="arrow" size={16} />
            </a>
          </div>
        </section>
      ))}
    </div>
  </section>
  <section class="home-library" aria-labelledby="library-title">
    <div class="section-heading">
      <div>
        <span class="section-kicker">
          {t("开放的工作记录", "An open record of making")}
        </span>
        <h2 id="library-title">
          {t("代码里，有更完整的我。", "There’s more in the code.")}
        </h2>
      </div>
      <span class="section-aside">
        {t(
          "按方向探索，或直接搜索。",
          "Explore a field, or search for something.",
        )}
      </span>
    </div>
    <div class="library-grid">
      <div class="directory-card">
        <div class="directory-top">
          <span>
            <Icon name="code" size={18} />
            {t("公开项目总览", "Public project directory")}
          </span>
          <a
            href={projectUrl}
            aria-label={t("打开项目总览", "Open project directory")}
          >
            <Icon name="external" size={23} />
          </a>
        </div>
        <div class="directory-number">
          <strong>{projects.length}</strong>
          <div>
            {t("个公开仓库", "public repositories")}
            <span>
              {original} {t("个非 Fork 仓库", "non-fork repositories")} ·{" "}
              {projects.length - original} Forks
            </span>
          </div>
        </div>
        <p>
          {t(
            "从可以上手的工具，到还在生长的实验。每个项目都有简介，也保留了它真实的阶段。",
            "From documented tools to experiments still taking shape. Every project has a description and an honest account of where it stands.",
          )}
        </p>
        <div class="category-links">
          {Object.entries(categories).map(([key, cat]) => (
            <a href={`${projectUrl}?category=${key}`}>
              <Icon name={cat.icon} size={17} />
              <span>{cat[lang]}</span>
              <span>{projects.filter((p) => p.category === key).length}</span>
            </a>
          ))}
        </div>
        <a class="directory-bottom" href={projectUrl}>
          {t("打开完整项目索引", "Open the complete directory")}
          <Icon name="arrow" size={19} />
        </a>
      </div>
      <div class="language-card panel">
        <div class="panel-heading">
          <span>{t("代码使用的语言", "Languages in the code")}</span>
          <Icon name="code" size={18} />
        </div>
        <p>
          {t(
            "不同的问题，不同的工具。",
            "Different problems. Different tools.",
          )}
        </p>
        <div class="language-bars">
          {languageCounts
            .filter((l) => l.name !== "Other")
            .slice(0, 5)
            .map((l, i) => (
              <a
                href={`${projectUrl}?language=${encodeURIComponent(l.name)}`}
                class="language-bar"
              >
                <span class="language-bar-label">
                  <span>
                    <i style={`--language-index:${i}`}></i>
                    {l.name}
                  </span>
                  <span>
                    {l.count}
                    <small>{t(" 仓库", " repos")}</small>
                  </span>
                </span>
                <span class="bar-track">
                  <i
                    style={`width:${(l.count / projects.length) * 100}%;--language-index:${i}`}
                  ></i>
                </span>
              </a>
            ))}
        </div>
        <span class="data-note">
          {t(
            "按 GitHub 标注的仓库主要语言统计。",
            "By each repository’s primary language on GitHub.",
          )}
        </span>
        <button
          type="button"
          class="search-card-button"
          data-open-search
          hidden
        >
          <Icon name="search" size={17} />
          {t("找一个项目或关键词", "Find a project or keyword")}
          <kbd>⌘ K</kbd>
        </button>
      </div>
    </div>
  </section>
  <section id="about" class="about-grid">
    <div class="about-card panel">
      <span class="section-kicker">{t("关于我", "A little about me")}</span>
      <h2>{t("从日常的问题开始。", "Starting with everyday questions.")}</h2>
      <p>
        {t(
          "我也叫 Peter。对我来说，做东西往往从一个很具体的问题开始：输入能不能更自然，系统能不能更顺手，屏幕上的想法能不能变成真实的交互。",
          "You can also call me Peter. Making things usually starts with a specific question: can writing feel more natural, can a system work more smoothly, can an idea on a screen become a physical interaction?",
        )}
      </p>
      <p>
        {t(
          "这里既有应用与工具，也有学习笔记和早期实验。它们一起记录了我如何学习、尝试和改进。",
          "This space includes applications and tools, alongside learning notes and early experiments. Together, they record how I learn, try things, and improve.",
        )}
      </p>
    </div>
    <div class="contact-card panel">
      <span class="section-kicker">{t("保持联系", "Get in touch")}</span>
      <h2>{t("聊聊你的想法。", "What are you working on?")}</h2>
      <p>
        {t(
          "项目、技术，或一个值得动手试试的想法。",
          "A project, a technical question, or an idea worth trying.",
        )}
      </p>
      <a href={`mailto:${site.email}`} class="contact-row">
        <Icon name="mail" size={19} />
        <span>{site.email}</span>
        <Icon name="external" size={17} />
      </a>
      <button type="button" class="copy-email" data-email={site.email} hidden>
        <span class="copy-label">{t("复制邮箱", "Copy email")}</span>
        <span class="copy-feedback" aria-live="polite"></span>
      </button>
      <a class="contact-row" href="https://github.com/ZiJie-Duan">
        <Icon name="github" size={19} />
        <span>github.com/ZiJie-Duan</span>
        <Icon name="external" size={17} />
      </a>
    </div>
  </section>
</Base>
<script>
  const tabs = document.querySelector<HTMLElement>(".direction-tabs");
  if (tabs) {
    tabs.hidden = false;
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const panels = [
      ...document.querySelectorAll<HTMLElement>(".direction-panel"),
    ];
    function activate(index: number) {
      buttons.forEach((b, i) => {
        b.setAttribute("aria-selected", String(i === index));
        b.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
    }
    activate(0);
    buttons.forEach((b, i) => {
      b.addEventListener("click", () => activate(i));
      b.addEventListener("keydown", (event) => {
        let next = i;
        if (event.key === "ArrowRight") next = (i + 1) % buttons.length;
        else if (event.key === "ArrowLeft")
          next = (i + buttons.length - 1) % buttons.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = buttons.length - 1;
        else return;
        event.preventDefault();
        activate(next);
        buttons[next].focus();
      });
    });
  }
  const copy = document.querySelector<HTMLButtonElement>(".copy-email");
  if (copy && navigator.clipboard) {
    copy.hidden = false;
    let timer: ReturnType<typeof setTimeout>;
    copy.addEventListener("click", async () => {
      const feedback = copy.querySelector<HTMLElement>(".copy-feedback")!;
      try {
        await navigator.clipboard.writeText(copy.dataset.email!);
        feedback.textContent =
          document.body.dataset.lang === "zh" ? "已复制" : "Copied";
      } catch {
        feedback.textContent =
          document.body.dataset.lang === "zh"
            ? "请选中上方邮箱复制"
            : "Select the email above to copy";
      }
      clearTimeout(timer);
      timer = setTimeout(() => (feedback.textContent = ""), 3500);
    });
  }
</script>
