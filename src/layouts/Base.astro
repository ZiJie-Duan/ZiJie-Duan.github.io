---
import "../styles/site.css";
import "../styles/studio.css";
import { site } from "../../site.config.mjs";
import { href, t, type Lang } from "../lib";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** The same page in the other language. */
  alternate: string;
  home?: boolean;
}

const { lang, title, description, alternate, home = false } = Astro.props;
const other: Lang = lang === "zh" ? "en" : "zh";
const name = site.name[lang];
const pageTitle = title === name ? name : `${title} · ${name}`;
---

<!doctype html>
<html lang={lang === "zh" ? "zh-Hans" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description ?? site.intro[lang]} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL("social.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="alternate"
      hreflang={other === "zh" ? "zh-Hans" : "en"}
      href={new URL(alternate, Astro.site)}
    />
    <link rel="icon" href={href("zh") + "favicon.svg"} type="image/svg+xml" />
  </head>
  <body class:list={[{ "studio-home": home }]}>
    <a class="skip-link" href="#main">
      {lang === "zh" ? "跳到正文" : "Skip to content"}
    </a>
    <header class="top">
      <a
        class="brand"
        href={href(lang)}
        aria-label={lang === "zh" ? "段子杰，首页" : "ZiJie Duan, home"}
      >
        <span class="brand-mark" aria-hidden="true">
          z.
        </span>
        <span>
          ZiJie Duan
          <span class="brand-sub">
            {lang === "zh" ? "段子杰 / 个人工作室" : "A PERSONAL STUDIO"}
          </span>
        </span>
      </a>
      <nav
        class="site-nav"
        aria-label={lang === "zh" ? "主导航" : "Main navigation"}
      >
        <a href={`${href(lang)}#work`}>{lang === "zh" ? "作品" : "Work"}</a>
        <a href={`${href(lang)}#about`}>{lang === "zh" ? "关于" : "About"}</a>
        <a
          class="lang"
          href={alternate}
          hreflang={other === "zh" ? "zh-Hans" : "en"}
        >
          {t(lang).other}
          <span aria-hidden="true"> ↗</span>
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="bottom">
      <span>
        © {new Date().getFullYear()} {site.owner[lang]}
      </span>
      <span class="footer-links">
        <a href={href(lang, "utter")}>
          {lang === "zh" ? "应用与支持" : "Apps & support"}
        </a>
        <a href="https://github.com/ZiJie-Duan">GitHub ↗</a>
        <a href={`mailto:${site.email}`}>{t(lang).contact} ↗</a>
      </span>
    </footer>
  </body>
</html>
